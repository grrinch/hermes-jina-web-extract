# Jina Reader credentials and upstream proxy settings.
# Copy the relevant lines to the target Hermes profile .env file.
# Set only one proxy variable.

# Optional: increases Jina Reader limits.
# JINA_API_KEY=replace-with-your-jina-api-key

# Optional: Jina upstream proxy URL.
# JINA_SOCKS5_PROXY=socks5://user:password@proxy.example:1080
# JINA_HTTP_PROXY=http://user:password@proxy.example:8080
